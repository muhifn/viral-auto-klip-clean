# Viral Auto Klip v4 - Environment Variables
# Salin ke .env lalu isi key yang kamu punya (cukup SATU provider AI).

# ===== Transkripsi =====
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=auto
WHISPER_ALLOW_LARGE_ON_GPU=0
WHISPER_GPU_SAFE_VRAM_GB=5.5
WHISPER_CUDA_DEVICE_INDEX=0
WHISPER_BEAM_SIZE=5
WHISPER_BATCH_SIZE=16
# Bahasa video: kosong = otomatis, id = Indonesia (mengaktifkan hint tanda baca), en = Inggris, ...
WHISPER_LANGUAGE=
WHISPER_INITIAL_PROMPT=Berikut adalah transkripsi video bahasa Indonesia dengan tanda baca yang benar.
# Transkripsi cloud (opsional)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
YTDLP_COOKIES=cookies.txt
DOWNLOAD_MAX_HEIGHT=1080
ENCODE_CQ=0

# ===== AI provider aktif =====
# Groq | OpenAI | Anthropic | Gemini | Antigravity | DeepSeek | Mistral | OpenRouter | Ollama | Custom
AI_PROVIDER=Groq
# Kosongkan untuk memakai model default provider
LLM_MODEL=llama-3.3-70b-versatile
# Cadangan otomatis bila provider utama gagal/rate-limit, mis.: Gemini,Groq  atau  Anthropic:claude-sonnet-5-5,Groq
AI_FALLBACK_PROVIDERS=
AI_MOMENT_FINDER=1
AI_CLIP_PACKAGING=1
AI_MAX_CANDIDATES=24

# ===== API key per provider (isi yang dipakai saja) =====
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Effort Claude: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_REFUSAL_FALLBACK=1
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Antigravity = Gemini lewat login akun Google (tanpa API key).
# Buat OAuth client "Desktop app" di console.cloud.google.com + aktifkan Generative Language API.
GOOGLE_AI_CLIENT_SECRET_FILE=
GOOGLE_AI_PROJECT_ID=

# Custom AI: endpoint OpenAI-compatible apa pun (vLLM, LM Studio, Together, Fireworks, proxy kantor, ...)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ===== Pro editing (v4) =====
# minimal | dinamis | maksimal
EDIT_STYLE=dinamis
JUMP_CUT_MAX_GAP=0.55
PROGRESS_BAR_COLOR=#FF3B6B
END_SCREEN_TEXT=Follow buat part selanjutnya!

# ===== Fitur editing =====
SCENE_SNAP_ENABLED=1
SCENE_SNAP_TOLERANCE=1.5
SCENE_DETECT_THRESHOLD=27
PEAK_THUMBNAIL=1
ENABLE_HOOK_PUNCH=1
PARALLEL_PROCESSING=1
PARALLEL_CLIPS=2

# ===== Publish / auto-upload =====
ENABLE_PUBLISH_PACKAGE=1
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_PRIVACY=public
YOUTUBE_UPLOAD_METHOD=auto
TIKTOK_COOKIES_FILE=
TIKTOK_UPLOADER_PATH=
# draft = posting privat (Only you, bisa dipublikasikan nanti); post = langsung posting
TIKTOK_UPLOAD_MODE=draft

# Opsional: engine API eksternal clipping.software
CLIPPING_SOFTWARE_API_KEY=

# ===== Studio v6: suara, gambar, stok =====
# TTS: edge (gratis, tanpa key) | openai | gemini | elevenlabs
TTS_PROVIDER=edge
TTS_VOICE=id-ID-ArdiNeural
# Gambar: kosong = otomatis (Gemini bila ada key, kalau tidak Pollinations gratis) | gemini | openai | pollinations | card
IMAGE_PROVIDER=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Opsional: tanpa token Pollinations dibatasi 1 gambar / 45 detik
POLLINATIONS_TOKEN=
# Footage & foto stok gratis (mode "Campur AI + stok" di Content Creator)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Opsional: Analitik Viral pakai chart mostPopular resmi (tanpa key = pencarian yt-dlp)
YOUTUBE_API_KEY=
SCHEDULER_INTERVAL=30

# ===== Editor-AI (v6.7): tinjauan kritis tiap klip sebelum render =====
# Menilai standalone/hook/payoff/emosi/kejelasan, merapikan batas potong, menolak klip lemah, dan menulis
# hook/judul/caption yang wajib terdukung kutipan dari klip (anti-halusinasi).
AI_EDITOR_REVIEW=1
REVIEW_MIN_STANDALONE=5
REVIEW_MIN_PAYOFF=5
REVIEW_MIN_SCORE=52

# ---- Upscale & restorasi wajah AI (v6.8) ----
# Butuh GPU NVIDIA + PyTorch CUDA (dipasang otomatis oleh start.bat). Model diunduh otomatis ke tools/models/.
# AI_UPSCALE=1          # Real-ESRGAN realesr-general-x4v3 (cadangan: ncnn animevideov3)
# AI_FACE_RESTORE=1     # GFPGAN v1.4: detail mata, kacamata, kulit
# AI_FACE_WEIGHT=0.6    # 0 = wajah asli, 1 = penuh GFPGAN (>0.8 bisa mengubah bentuk bibir/identitas)

# ---- Pacing (v6.8) ----
# Tempo adaptif: klip dengan pembicara lambat dipercepat halus (nada suara tetap). Aktif di preset Dinamis/Maksimal.
# AUTO_TEMPO=1
# AUTO_TEMPO_TARGET_WPS=3.15   # kata per detik yang dituju (podcast uji: median 2,93)
# AUTO_TEMPO_MAX=1.08          # di atas ±1,1x mulai terdengar dipercepat

# ---- Riset tren (v6.8) ----
# Analitik Viral / Saran Viral AI / Optimasi Judul memakai video YouTube HARI INI & MINGGU INI (urut views),
# topik yang naik di judul (mis. "GTA 6"), dan Google Trends Indonesia — tanpa API key. Diperbarui otomatis.
# TRENDS_AUTO_REFRESH=1
# TRENDS_REFRESH_MIN=60
# YOUTUBE_API_KEY=   # opsional (gratis, Google Cloud): tambah daftar video Populer resmi YouTube Indonesia

# ---- Video AI generatif (v6.8) — Content Creator / Story Studio / Motion Graphic ----
# Adegan dihidupkan jadi video sungguhan (gambar→video atau teks→video). Berbayar per detik di akun provider;
# adegan lain tetap gerak kamera (gratis). Gagal/kuota habis → otomatis kembali ke gerak kamera.
# Gemini Omni Flash (pengganti Veo 3.1 Preview yang dimatikan 22 Okt 2026) memakai GEMINI_API_KEY.
# GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
# KLING_API_KEY=                       # API Key standar baru (bukan AK/SK lama) dari konsol developer Kling
# KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_VIDEO_MODEL=kling-3.0-turbo
# VIDEO_AI_RESOLUTION=720p
# VIDEO_AI_MAX_SCENES=4                # batas adegan yang dihidupkan per video (kontrol biaya)

# ---- Upload otomatis (v6.8) ----
# Centang "Upload otomatis ke jam FYP terbaik" di Analisis AI: klip langsung dijadwalkan ke jam ramai sesuai niche
# & platform, lalu diupload sendiri (YouTube/TikTok harus sudah terhubung di Jadwal Upload).
# GLOBAL_HASHTAGS=#namachannel #fyp    # ditambahkan ke SEMUA upload
# AUTO_PUBLISH_PER_DAY=3               # maks per platform per hari
# AUTO_PUBLISH_MIN_GAP_H=2.5           # jarak minimal antar upload (jam)
# AUTO_MIN_DURATION=20                 # durasi minimum mode otomatis (live/gaming: 22)
